# Copie para .env e preencha. NUNCA versione o .env real.

# Ollama Cloud (Modelo gpt-oss:120b. deepseek-v4-flash requer subscrição — não usar)
IA_API_KEY=
IA_MODELO=gpt-oss:120b
IA_URL=https://api.ollama.com
IA_TIMEOUT=120

# Top-K de recuperação e pontuação mínima
IA_TOP_K=5
IA_SCORE_MIN=0.15

# Protecção contra abuso
IA_RATE_MAX=20
IA_RATE_WINDOW=60
# Em produção atrás de proxy, defina o cabeçalho do IP real:
# Cloudflare: CF-Connecting-IP | Nginx: HTTP_X_REAL_IP
IA_PROXY_HEADER=

# Segredo para GET /ia/status (deixar vazio = endpoint aberto; NÃO recomendado em produção)
IA_STATUS_TOKEN=

# Origens CORS extra (separadas por vírgula), ex.: https://cda-mz.org,https://www.cda-mz.org
IA_ORIGINS=
